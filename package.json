{
	"name": "@projectwallace/css-code-coverage",
	"version": "1.0.5",
	"description": "Generate useful CSS Code Coverage report from browser-reported coverage",
	"keywords": [
		"code",
		"coverage",
		"css",
		"dead",
		"styles",
		"testing",
		"unused",
		"used"
	],
	"homepage": "https://github.com/projectwallace/css-code-coverage",
	"bugs": "https://github.com/projectwallace/css-code-coverage/issues",
	"license": "EUPL-1.2",
	"author": "Bart Veneman <bart@projectwallace.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/projectwallace/css-code-coverage.git"
	},
	"bin": {
		"css-coverage": "dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "c8 --reporter=text --reporter=lcov playwright test",
		"build": "tsdown",
		"check": "tsc --noEmit",
		"lint": "oxlint --config .oxlintrc.json; oxfmt --check",
		"knip": "knip",
		"precommit": "pnpm test && pnpm check && pnpm lint && pnpm knip"
	},
	"dependencies": {
		"@projectwallace/css-parser": "~0.18.9",
		"@projectwallace/format-css": "^3.2.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@projectwallace/preset-oxlint": "^0.0.11",
		"@types/node": "^26.6.5",
		"c8": "^12.0.0",
		"knip": "^6.42.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@projectwallace/css-parser": "$@projectwallace/css-parser"
	},
	"engines": {
		"node": ">=20",
		"pnpm": ">=11.16.0"
	},
	"packageManager": "pnpm@11.16.0"
}
