{
	"compilerOptions": {
		// Base options:
		"skipLibCheck": true,
		"target": "es2024",
		"verbatimModuleSyntax": true,
		"allowJs": false,
		"moduleDetection": "force",
		// Strictness
		"strict": true,
		"noUncheckedIndexedAccess": true,
		// Type checking, not transpiling
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"es2024",
			"DOM"
		],
		"declaration": true,
		"rootDirs": ["src/lib", "src/cli"],
		"outDir": "dist"
	},
	"include": [
		"src/lib/index.ts",
		"src/cli/cli.ts",
		"src/lib/*.d.ts"
	],
	"exclude": [
		"node_modules",
	]
}